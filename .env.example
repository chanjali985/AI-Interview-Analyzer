# ============================================================================
# AI Interview Analyzer — copy to .env and fill in.
#   cp .env.example .env
# Never commit the real .env: it holds your SMTP app password and secret key.
# ============================================================================

# ---------------------------------------------------------------- application
APP_NAME="AI Interview Analyzer"
COMPANY_NAME="Your Company"          # shown to candidates in the UI and emails
ENVIRONMENT=development              # development | staging | production
LOG_LEVEL=INFO

# The public URL candidates will open. Invite links are built from this, so it
# MUST be the address people can actually reach (https in production).
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --------------------------------------------------------------------- secrets
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string

# Bootstrap recruiter account, created on first start. CHANGE THE PASSWORD.
ADMIN_EMAIL=you@yourcompany.com
ADMIN_NAME="Hiring Admin"
ADMIN_PASSWORD=change-me-now

ACCESS_TOKEN_EXPIRE_MINUTES=720      # recruiter session length
INVITE_TOKEN_EXPIRE_HOURS=168        # how long a candidate link stays valid

# -------------------------------------------------------------------- database
# SQLite is fine for a single instance; Postgres for anything shared.
DATABASE_URL=sqlite:///./data/interviews.db
# DATABASE_URL=postgresql+psycopg://interview:interview@db:5432/interview

# ------------------------------------------------------------------------- AI
# ollama = free and local (default). openai | groq | gemini = hosted API.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120

# Only needed for the matching LLM_PROVIDER:
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=

# --------------------------------------------------------------- transcription
# faster_whisper = local and free (default). openai = Whisper API. google = free
# but unofficial and rate-limited.
TRANSCRIPTION_PROVIDER=faster_whisper
WHISPER_MODEL=base                   # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en                  # leave blank to auto-detect

# ------------------------------------------------------------------ embeddings
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================================
# EMAIL — this is what sends the score report to the candidate.
#
# Gmail requires an App Password, NOT your normal password:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:      https://myaccount.google.com/apppasswords
#   3. Paste the 16 characters below with the spaces removed.
# ============================================================================
MAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password

MAIL_FROM=your-address@gmail.com
MAIL_FROM_NAME="Your Company Hiring"
# MAIL_REPLY_TO=hiring@yourcompany.com

# Gets a copy of every finished report and every failure alert.
RECRUITER_NOTIFY_EMAIL=your-address@gmail.com

SEND_SCORES_TO_CANDIDATE=true        # false = only the recruiter sees scores
ATTACH_PDF_REPORT=true
PDF_INCLUDE_TRANSCRIPTS=true

# --------------------------------------------------------------------- uploads
STORAGE_DIR=./data/uploads
MAX_AUDIO_MB=25
MAX_RESUME_MB=10

# ------------------------------------------------------------ scoring & limits
ANALYSIS_WORKERS=2                   # concurrent interviews analysed
SHORTLIST_THRESHOLD=7.0              # score at or above this = "shortlist"
RELEVANCE_WEIGHT=0.15                # how much resume/answer match moves the score
WEIGHT_COMMUNICATION=0.2
WEIGHT_TECHNICAL=0.3
WEIGHT_CONFIDENCE=0.15
WEIGHT_CLARITY=0.15
WEIGHT_OVERALL=0.2

RATE_LIMIT_ENABLED=true
RATE_LIMIT_SUBMISSIONS_PER_HOUR=20

SEED_STARTER_ROLE=true               # create one sample role on an empty database
